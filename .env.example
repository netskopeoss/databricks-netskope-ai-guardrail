# ---------------------------------------------------------------------------
# AI Guardrails on Demand + Databricks adapter — deploy config.
# Copy this to `.env` and fill in. `.env` is gitignored; this `.env.example`
# is committed. NO SECRETS GO HERE.
#
# AWS credentials are NOT set in this file. Use your normal aws CLI config /
# SSO / environment. Confirm with:  aws sts get-caller-identity
#
# NETSKOPE TENANT CREDS ARE NOT NEEDED FOR EITHER STACK. Both templates are
# infrastructure-only: tenant activation (enroll the VPE node, attach the AI
# Guardrails service template in the Netskope UI, generate the dataplane cert
# via the VPE CLI) is manual and never touches CloudFormation.
# ---------------------------------------------------------------------------

AWS_REGION=us-east-1
STACK_NAME=netskope-guardrails

# ===== Guardrails appliance (./deploy.ps1) =====

# Existing network in AWS_REGION.
#   ALB_SUBNET_IDS      : two subnets, different AZs, >= 8 free IPs each
#   PRIVATE_SUBNET_IDS  : private subnet(s) with NAT (appliance egress)
VPC_ID=vpc-xxxxxxxx
ALB_SUBNET_IDS=subnet-aaaa,subnet-bbbb
PRIVATE_SUBNET_IDS=subnet-cccc

# Netskope VPE appliance AMI (shared with your account by your Netskope
# account team - ask them for the current AMI ID in your region).
GUARDRAILS_AMI_ID=ami-xxxxxxxxxxxxxxxxx

# Optional overrides — template defaults are fine for a test:
#GUARDRAILS_INSTANCE_TYPE=m5.2xlarge
#HOSTED_ZONE_NAME=guardrails.internal
#GUARDRAILS_DOMAIN_NAME=guardrails.guardrails.internal

# Optional EC2 key pair for SSH to the VPE appliance (manual enrollment /
# VPE CLI). The appliance accepts publickey auth only, so set this if you
# need shell access. Must be an existing key pair name in AWS_REGION.
#GUARDRAILS_KEY_NAME=guardrails-key

# ===== Databricks adapter (./deploy-databricks-adapter.ps1) =====

# Any subnet in the SAME VPC as the Guardrails appliance (VPC_ID above) - the
# Lambda only needs VPC-local reachability to the appliance's internal ALB,
# not internet/NAT access, so any subnet in that VPC works.
LAMBDA_SUBNET_IDS=subnet-dddd

# Optional overrides:
#DATABRICKS_ADAPTER_STACK_NAME=netskope-databricks-adapter
#AIGOD_EVALUATION_URL=https://guardrails.aigw.internal/api/v2/aiguardrails/evaluation
#CERT_PARAMETER_NAME=/netskope-guardrails/guardrails-cert
#DEFAULT_PROFILE_ID=

# ===== Optional org tagging (applies to both stacks, if set) =====
# Only the ones you set are applied - leave all commented to skip tagging.
#TAG_OWNER=you@example.com
#TAG_PROJECT_TYPE=internal
#TAG_COST_CENTER=
#TAG_STAGE=lab
#TAG_SENSITIVITY=none

# Optional: path to a corporate TLS-inspection CA bundle, if your machine
# needs one for aws/curl. Leave commented if not applicable.
#CA_BUNDLE=C:\path\to\corp-ca-bundle.pem
